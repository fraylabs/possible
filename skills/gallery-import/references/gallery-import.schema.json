{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://possible.sh/schemas/gallery-import.schema.json",
  "title": "Possible Gallery Import",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "source", "company", "product", "items", "warnings"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "inspectedAt"],
      "properties": {
        "url": { "$ref": "#/$defs/httpsUrl" },
        "inspectedAt": { "type": "string", "format": "date-time" }
      }
    },
    "company": { "$ref": "#/$defs/sourceIdentity" },
    "product": { "$ref": "#/$defs/sourceIdentity" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceKey", "sourceUrl", "title", "prompt", "resultMediaUrl", "posterUrl", "model", "authorName", "authorUrl", "sourcePublishedAt"],
        "properties": {
          "sourceKey": { "type": "string", "minLength": 1 },
          "sourceUrl": { "$ref": "#/$defs/httpsUrl" },
          "title": { "$ref": "#/$defs/nullableText" },
          "prompt": { "$ref": "#/$defs/nullableText" },
          "resultMediaUrl": { "$ref": "#/$defs/nullableHttpsUrl" },
          "posterUrl": { "$ref": "#/$defs/nullableHttpsUrl" },
          "model": { "$ref": "#/$defs/nullableText" },
          "authorName": { "$ref": "#/$defs/nullableText" },
          "authorUrl": { "$ref": "#/$defs/nullableHttpsUrl" },
          "sourcePublishedAt": {
            "oneOf": [
              { "type": "string", "format": "date-time" },
              { "type": "null" }
            ]
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["itemSourceKey", "field", "message"],
        "properties": {
          "itemSourceKey": { "$ref": "#/$defs/nullableText" },
          "field": { "$ref": "#/$defs/nullableText" },
          "message": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "httpsUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
    "nullableHttpsUrl": {
      "oneOf": [
        { "$ref": "#/$defs/httpsUrl" },
        { "type": "null" }
      ]
    },
    "nullableText": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "null" }
      ]
    },
    "sourceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "websiteUrl"],
      "properties": {
        "name": { "$ref": "#/$defs/nullableText" },
        "websiteUrl": { "$ref": "#/$defs/nullableHttpsUrl" }
      }
    }
  }
}

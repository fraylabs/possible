{
  "name": "@possible/packs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./local": {
      "types": "./dist/local.d.ts",
      "import": "./dist/local.js"
    },
    "./submission": {
      "types": "./dist/submission.d.ts",
      "import": "./dist/submission.js"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "prebuild": "node --input-type=module --eval \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc -p tsconfig.json",
    "snapshots:refresh": "node scripts/refresh-bundled-snapshots.mjs",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}

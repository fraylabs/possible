# Written by `npx convex dev` for local development.
CONVEX_DEPLOYMENT=
CONVEX_URL=
CONVEX_SITE_URL=

# Exposed to the static Next.js client.
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
NEXT_PUBLIC_GITHUB_AUTH_ENABLED=false

# Required by Convex Auth's GitHub provider.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Optional server-side access for public GitHub source registration.
GITHUB_TOKEN=

# Override the public directory from the CLI or MCP.
POSSIBLE_DIRECTORY_ENDPOINT=
POSSIBLE_PUBLISH_URL=
